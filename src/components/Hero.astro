---
/**
 * First viewport: the name, what the owner is looking for, how to get in touch, and
 * the roles running in parallel as lanes on a shared time axis.
 */
import type { Span } from '@lib/types';

interface Lane {
  /** Track name, e.g. "Robotics". */
  label: string;
  /** Anchor of the entry this lane summarises. */
  href: string;
  /** Headline figure and what it measures. */
  figure: string;
  caption: string;
  organization: string;
  span: Span;
}

interface Action {
  label: string;
  href: string;
}

interface Props {
  name: string;
  /** Short sentences shown under the name. */
  statements: string[];
  primaryAction: Action;
  secondaryActions: Action[];
  lanes: Lane[];
}

const { name, statements, primaryAction, secondaryActions, lanes } = Astro.props;
const isExternal = (href: string) => href.startsWith('http');
---

<header class="hero" id="top">
  <h1>{name}</h1>

  <p class="statement">
    {statements.map((statement) => <span>{statement} </span>)}
  </p>

  <ul class="actions">
    <li><a class="primary" href={primaryAction.href}>{primaryAction.label}</a></li>
    {
      secondaryActions.map((action) => (
        <li>
          <a class="secondary" href={action.href} rel={isExternal(action.href) ? 'noopener' : undefined}>
            {action.label}
          </a>
        </li>
      ))
    }
  </ul>

  <div class="rule"></div>

  <ol class="lanes" aria-label="Current roles, in the order they started">
    {
      lanes.map((lane, index) => (
        <li class="lane" style={`--i:${index}`}>
          <p class="lane-label">{lane.label}</p>
          <a
            class={`block block-${index % 3}`}
            href={lane.href}
            data-span-link
            data-span-name={lane.organization}
            data-span-t={lane.span.t}
            data-span-period={lane.span.period}
            data-span-from={lane.span.from}
            data-span-to={lane.span.to}
            data-span-ongoing={lane.span.ongoing ? '' : undefined}
          >
            <span class="block-time">
              {lane.span.t} · {lane.span.period}
            </span>
            <strong class="block-figure">{lane.figure}</strong>
            <span class="block-caption">{lane.caption}</span>
            <span class="block-org">{lane.organization}</span>
          </a>
        </li>
      ))
    }
  </ol>
</header>

<style>
  .hero {
    padding: var(--space-7) var(--gutter) 0;
    padding-right: var(--gutter-end, var(--gutter));
  }

  h1 {
    max-width: 8.6em;
    font-size: var(--text-display);
    text-wrap: wrap;
    font-weight: 800;
    font-stretch: 96%;
    line-height: 0.92;
    letter-spacing: -0.03em;
  }

  .statement {
    max-width: 46ch;
    margin-top: var(--space-5);
    font-size: var(--text-md);
    line-height: 1.4;
    font-weight: 500;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
    margin-top: var(--space-5);
  }

  .primary {
    display: inline-block;
    padding: 0.8rem 1.4rem;
    background: var(--orange);
    color: var(--navy);
    font-weight: 700;
    text-decoration: none;
    transition:
      background-color var(--dur-fast) linear,
      color var(--dur-fast) linear;
  }

  .primary:hover {
    background: var(--navy);
    color: var(--paper);
  }

  .secondary {
    font-weight: 600;
  }

  /* Lanes: time runs down, so a role that started later starts lower. */
  .lanes {
    --step: clamp(1.5rem, 3.4vw, 3.25rem);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5);
    padding-top: var(--space-5);
  }

  /* The heavy rule runs from the rail to the right edge of the page. */
  .rule {
    margin-top: var(--space-6);
    margin-left: calc(-1 * var(--gutter));
    margin-right: calc(-1 * var(--gutter-end, var(--gutter)));
    border-top: var(--rule-heavy) solid var(--navy);
  }

  .lane {
    display: flex;
    flex-direction: column;
    padding-left: var(--space-4);
    border-left: var(--rule-heavy) solid var(--navy);
    container-type: inline-size;
  }

  .lane-label {
    font-weight: 800;
    font-stretch: 96%;
    font-size: 1.5rem;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .block {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-1);
    min-height: 13.5rem;
    margin-top: calc(var(--space-4) + var(--i) * var(--step));
    padding: var(--space-4) var(--space-4) var(--space-5);
    text-decoration: none;
    transition:
      background-color var(--dur-fast) linear,
      color var(--dur-fast) linear;
  }

  .block-0 {
    background: var(--orange);
    color: var(--navy);
    --block-soft: var(--orange-ink);
  }

  .block-1 {
    background: var(--navy);
    color: var(--paper);
    --block-soft: var(--paper-soft);
    --focus: var(--orange);
  }

  .block-2 {
    color: var(--navy);
    --block-soft: var(--navy-soft);
    box-shadow: inset 0 0 0 var(--rule-heavy) var(--navy);
  }

  .block-0:hover,
  .block-2:hover {
    background: var(--navy);
    color: var(--paper);
    --block-soft: var(--paper-soft);
  }

  .block-1:hover {
    background: var(--orange);
    color: var(--navy);
    --block-soft: var(--orange-ink);
  }

  .block-time {
    font-family: var(--font-type);
    font-size: var(--text-xs);
    line-height: 1.3;
    color: var(--block-soft);
  }

  .block-figure {
    margin-top: var(--space-3);
    font-size: clamp(2.5rem, 24cqi, 5.75rem);
    font-weight: 800;
    font-stretch: 80%;
    line-height: 0.95;
    letter-spacing: -0.03em;
    white-space: nowrap;
  }

  .block-caption {
    font-size: var(--text-base);
    line-height: 1.3;
    font-weight: 500;
  }

  .block-org {
    font-size: var(--text-sm);
    line-height: 1.3;
    color: var(--block-soft);
  }

  @media (max-width: 47.99rem) {
    .lanes {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }

    .block {
      min-height: 0;
      margin-top: var(--space-3);
      margin-left: calc(var(--i) * 1.25rem);
    }

    .block {
      padding-bottom: var(--space-6);
    }

    .block-figure {
      font-size: clamp(2.75rem, 18cqi, 4.5rem);
    }
  }

  /* The one authored moment: blocks extend down their lanes in time order. */
  @media (prefers-reduced-motion: no-preference) {
    .block {
      animation: extend 900ms var(--ease-out) both;
      animation-delay: calc(120ms + var(--i) * 140ms);
    }

    @keyframes extend {
      from {
        clip-path: inset(0 0 100% 0);
      }
      to {
        clip-path: inset(0 0 0 0);
      }
    }
  }
</style>
