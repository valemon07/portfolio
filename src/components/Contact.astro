---
/**
 * The close: what the owner is looking for and every way to get in touch.
 */
interface Props {
  email: string;
  links: { label: string; handle: string; url: string }[];
  /** Shown only when a public résumé file exists. */
  resumeUrl?: string;
  signoff: string;
}

const { email, links, resumeUrl, signoff } = Astro.props;
---

<p class="email">
  <a href={`mailto:${email}`}>{email}</a>
</p>

<ul class="links">
  {
    links.map((link) => (
      <li>
        <a href={link.url} rel="noopener">
          <span class="link-label">{link.label}</span>
          <span class="link-handle">{link.handle}</span>
        </a>
      </li>
    ))
  }
  {
    resumeUrl && (
      <li>
        <a href={resumeUrl} download>
          <span class="link-label">Résumé</span>
          <span class="link-handle">PDF</span>
        </a>
      </li>
    )
  }
</ul>

<p class="signoff">{signoff}</p>

<style>
  .email {
    font-size: clamp(1.5rem, 0.6rem + 3.6vw, 3.25rem);
    font-weight: 800;
    font-stretch: 96%;
    line-height: 1.1;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-7);
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: var(--rule-heavy) solid var(--line);
  }

  .links a {
    display: grid;
    gap: var(--space-1);
    text-decoration: none;
  }

  .link-label {
    font-size: var(--text-md);
    font-weight: 800;
    line-height: 1.2;
    text-decoration: underline;
    text-decoration-thickness: 0.09em;
    text-underline-offset: 0.2em;
  }

  .links a:hover .link-label {
    text-decoration-thickness: 0.18em;
  }

  .link-handle {
    font-size: var(--text-sm);
    font-weight: 500;
    line-height: 1.3;
    color: var(--fg-soft);
  }

  .signoff {
    margin-top: var(--space-8);
    font-size: var(--text-sm);
    color: var(--fg-soft);
  }
</style>
