---
/**
 * The body of a role or project: title, what it was, what was done, measured
 * results, and what it was built with. Links and an image appear only when
 * they are provided.
 */
import type { Metric } from '@lib/types';

interface Props {
  title: string;
  subtitle: string;
  lead?: string;
  highlights: string[];
  metrics?: Metric[];
  stack?: string[];
  links?: { label: string; href: string }[];
  image?: { src: string; alt: string };
}

const { title, subtitle, lead, highlights, metrics = [], stack = [], links = [], image } = Astro.props;
---

<h3>{title}</h3>
<p class="subtitle">{subtitle}</p>

{image && <img class="image" src={image.src} alt={image.alt} loading="lazy" decoding="async" />}

{lead && <p class="lead">{lead}</p>}

<ul class="highlights">
  {highlights.map((highlight) => <li>{highlight}</li>)}
</ul>

{
  metrics.length > 0 && (
    <dl class="metrics">
      {metrics.map((metric) => (
        <div>
          <dt>{metric.label}</dt>
          <dd>{metric.value}</dd>
        </div>
      ))}
    </dl>
  )
}

{
  stack.length > 0 && (
    <p class="stack">
      <span class="stack-label">Built with</span> {stack.join(', ')}
    </p>
  )
}

{
  links.length > 0 && (
    <ul class="links">
      {links.map((link) => (
        <li>
          <a href={link.href} rel="noopener">
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  h3 {
    font-size: var(--text-lg);
    font-weight: 800;
    font-stretch: 96%;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .subtitle {
    margin-top: var(--space-2);
    font-size: var(--text-md);
    line-height: 1.3;
    font-weight: 500;
    color: var(--fg-soft);
  }

  .image {
    margin-top: var(--space-5);
    border: 1px solid var(--line-soft);
  }

  .lead {
    margin-top: var(--space-5);
    font-weight: 600;
  }

  .highlights {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-5);
    padding-left: 1.15em;
    list-style: square;
  }

  .lead + .highlights {
    margin-top: var(--space-3);
  }

  .highlights li::marker {
    color: var(--accent);
  }

  /* Measured results: the figure leads, the label explains it. */
  .metrics {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-6);
    margin-top: var(--space-5);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line-soft);
  }

  .metrics div {
    display: grid;
    align-content: start;
    gap: var(--space-1);
    max-width: 15rem;
  }

  .metrics dd {
    order: -1;
  }

  .metrics dd {
    font-size: 2.25rem;
    font-weight: 800;
    font-stretch: 80%;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .metrics dt {
    font-size: var(--text-sm);
    line-height: 1.3;
    color: var(--fg-soft);
  }

  .stack {
    margin-top: var(--space-5);
    font-size: var(--text-sm);
    color: var(--fg-soft);
  }

  .stack-label {
    font-weight: 700;
    color: var(--fg);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-4);
    font-weight: 600;
  }
</style>
